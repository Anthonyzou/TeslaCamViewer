{
  "name": "teslacamviewer-server",
  "version": "1.0.0",
  "description": "B2 Proxy and Static Server for TeslaCamViewer",
  "type": "module",
  "scripts": {
    "build": "node build.ts",
    "dev": "node build.ts --watch",
    "prestart": "npm run build",
    "start": "node server/index.ts",
    "test": "node --test",
    "lint": "eslint",
    "docker": "docker build -t anthonyzou/teslacamviewer .  --platform linux/arm64",
    "postdocker": "docker push anthonyzou/teslacamviewer",
    "typecheck": "vue-tsc --noEmit"
  },
  "dependencies": {
    "@types/leaflet": "1.9.22",
    "@types/leaflet.markercluster": "1.5.6",
    "@vueuse/core": "15.0.0",
    "axios": "^1.20.0",
    "backblaze-b2": "1.7.1",
    "chart.js": "4.6.1",
    "cors": "^2.8.6",
    "dayjs": "1.11.23",
    "dotenv": "^18.0.8",
    "express": "5.3.0",
    "idb": "8.0.4",
    "leaflet": "1.9.4",
    "leaflet.markercluster": "1.5.3",
    "@lucide/vue": "1.64.0",
    "mediabunny": "1.62.0",
    "uuid": "14.0.3",
    "vue": "3.5.44"
  },
  "devDependencies": {
    "@tailwindcss/node": "4.3.3",
    "@tailwindcss/oxide": "4.3.3",
    "@tailwindcss/vite": "4.3.3",
    "@types/cors": "2.8.19",
    "@types/express": "5.0.6",
    "@types/node": "26.6.5",
    "eslint": "10.13.0",
    "eslint-plugin-better-tailwindcss": "4.10.0",
    "eslint-plugin-vue": "10.11.1",
    "fake-indexeddb": "6.2.6",
    "globals": "17.13.0",
    "jiti": "2.7.0",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.0",
    "unplugin-vue": "8.0.0",
    "vite": "8.3.4",
    "vue-tsc": "3.3.13"
  }
}
